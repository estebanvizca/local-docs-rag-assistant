# Ollama endpoint. The app must never point to a remote API.
OLLAMA_HOST=http://localhost:11434

# Models are configuration, not code. Pull them locally before running.
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval: number of chunks passed to the chat model.
TOP_K=3

# Selected on the validation split with:
#   python eval/evaluate.py --tune-threshold
# 0.60 is the value obtained with the sample corpus and nomic-embed-text.
# Retune it whenever the documents or the embedding model change.
SIMILARITY_THRESHOLD=0.60

# Per-request timeout in seconds for local model calls.
REQUEST_TIMEOUT=300
